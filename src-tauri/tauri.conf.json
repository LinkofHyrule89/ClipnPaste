{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipnPaste",
  "version": "0.2.11",
  "identifier": "com.matt.clipnpaste",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipnPaste",
        "width": 800,
        "height": 600,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: asset:; connect-src ipc: tauri:; img-src 'self' asset: tauri: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' asset: tauri:; media-src 'self' data: blob:; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ],
        "files": {
          "/usr/bin/clipnpaste-cli": "target/release/clipnpaste-cli",
          "/etc/xdg/autostart/clipnpaste.desktop": "../assets/clipnpaste.desktop",
          "/usr/share/applications/ClipnPaste.desktop": "../assets/clipnpaste.desktop",
          "/usr/share/icons/hicolor/16x16/apps/clipnpaste.png": "icons/hicolor/16x16/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/22x22/apps/clipnpaste.png": "icons/hicolor/22x22/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/24x24/apps/clipnpaste.png": "icons/hicolor/24x24/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/32x32/apps/clipnpaste.png": "icons/hicolor/32x32/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/48x48/apps/clipnpaste.png": "icons/hicolor/48x48/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/64x64/apps/clipnpaste.png": "icons/hicolor/64x64/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/96x96/apps/clipnpaste.png": "icons/hicolor/96x96/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/128x128/apps/clipnpaste.png": "icons/hicolor/128x128/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/256x256/apps/clipnpaste.png": "icons/hicolor/256x256/apps/clipnpaste.png",
          "/usr/share/icons/hicolor/512x512/apps/clipnpaste.png": "icons/hicolor/512x512/apps/clipnpaste.png"
        }
      }
    }
  }
}
